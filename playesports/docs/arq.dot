digraph A {
 graph [rankdir=LR, fontname="Helvetica", pad=0.4, nodesep=0.6, ranksep=1.1, label="PlayEsports - Arquitetura", labelloc=t, fontsize=20];
 node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.25,0.15"];
 edge [fontname="Helvetica", fontsize=10];
 user [label="Cliente\n(celular / navegador)", fillcolor="#ede8e5"];
 front [label="Front-end\nReact + Vite\n(mobile-first)", fillcolor="#c9e6d4"];
 sb [label="Supabase\nAuth + API REST + RLS", fillcolor="#bfe0cc"];
 pg [label="PostgreSQL\nusuarios | quadras | reservas", fillcolor="#a8d5ba", shape=cylinder];
 n8n [label="n8n (fase 2)\nAutomacao", fillcolor="#fff3cd"];
 wa [label="WhatsApp\nconfirmacao e lembrete", fillcolor="#fff3cd"];
 user -> front [label="HTTPS"]; front -> sb [label="supabase-js"]; sb -> pg [label="SQL / RLS"];
 pg -> n8n [label="nova reserva", style=dashed]; n8n -> wa [style=dashed]; wa -> user [style=dashed, label="mensagem"];
}
